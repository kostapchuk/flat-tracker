<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>by.newbor.flat-tracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/kirillostapchuk/flat-tracker/check.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kirillostapchuk/flat-tracker</string>

    <!-- каждые 15 минут -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/kirillostapchuk/flat-tracker/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kirillostapchuk/flat-tracker/launchd.err.log</string>
</dict>
</plist>
