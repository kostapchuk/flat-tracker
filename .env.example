# Скопируй в .env и заполни:  cp .env.example .env
#
# Это настройки проверялки (check.py). Бот на Deno Deploy настраивается
# отдельно, своими переменными окружения — см. bot/main.ts и README.

# --- рассылка через бота (основной путь) ---------------------------------
# Адрес бота на Deno Deploy и общий с ним секрет
BOT_URL=https://<имя-проекта>.deno.dev
BROADCAST_SECRET=<та же строка, что в переменных Deno Deploy>

# --- запасной путь -------------------------------------------------------
# Если BOT_URL не задан, check.py шлёт напрямую в этот чат.
# Токен нужен ещё и для --test-telegram.
TELEGRAM_BOT_TOKEN=123456789:AAAA-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
TELEGRAM_CHAT_ID=123456789

# --- необязательное ------------------------------------------------------
# Свой фильтр (по умолчанию — свободные от 70 м², любой дом; см. check.py)
# FILTER_URL=https://newbor.by/podbor-kvartiry/?FILTER_NAME=arrFlatFilter&...

