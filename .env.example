# Скопируй в .env и заполни:  cp .env.example .env

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# Куда слать. Свой id: напиши боту любое сообщение и открой
# https://api.telegram.org/bot<ТОКЕН>/getUpdates -> result[0].message.chat.id
# Для группы id будет отрицательным (-100...).
TELEGRAM_CHAT_ID=123456789

# Необязательно: свой URL фильтра (по умолчанию — дом 14.3, 70–102 м², см. check.py)
# FILTER_URL=https://newbor.by/podbor-kvartiry/?FILTER_NAME=arrFlatFilter&...

# Сообщать не только о новых, но и об исчезнувших квартирах (забронировали/продали)
NOTIFY_REMOVED=0
